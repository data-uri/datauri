{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "lib": ["es2017"],
    "noImplicitAny": true,
    "esModuleInterop": true,
    "declaration": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": true,
    "baseUrl": "."
  }
}
